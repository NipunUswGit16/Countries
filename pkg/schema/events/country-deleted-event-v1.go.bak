package events

import (
	"context"
	"time"

	"bitbucket.org/ifs-pd/countries/pkg/schema"
	"bitbucket.org/ifs-pd/kairos-component-common/common/messaging"
	messagingEvents "bitbucket.org/ifs-pd/kairos-component-common/common/messaging/events"
	"bitbucket.org/ifs-pd/nga-common/validation"
	"bitbucket.org/ifs-pd/nga-common/validation/check"
	"bitbucket.org/ifs-pd/nga-common/validation/runner"
)

var _ messaging.Event = (*messagingEvents.EventMessage[*CountryDeletedEventV1])(nil)
var _ messaging.MessagePayload = &CountryDeletedEventV1{}

type CountryDeletedEventV1 struct {
	Id        string    `json:"id"`
	CountryId string    `json:"countryId"`
	DeletedAt time.Time `json:"deletedAt"`
}

var countryDeletedValidator = validation.New(func(e *CountryDeletedEventV1, r *runner.Runner[*CountryDeletedEventV1]) {

	check.StringField(r, "Id", e.Id).
		NotEmpty("id cannot be empty")

	check.StringField(r, "CountryId", e.CountryId).
		NotEmpty("countryId cannot be empty")
})

func (e *CountryDeletedEventV1) Validate(ctx context.Context) error {
	return messaging.Validate(ctx, countryDeletedValidator, e)
}

func (e *CountryDeletedEventV1) ComponentName() string {
	return schema.ComponentName
}
