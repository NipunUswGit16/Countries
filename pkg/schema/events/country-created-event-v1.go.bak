package events

import (
	"context"
	"time"

	"bitbucket.org/ifs-pd/countries/pkg/schema"
	"bitbucket.org/ifs-pd/kairos-component-common/common/messaging"
	messagingEvents "bitbucket.org/ifs-pd/kairos-component-common/common/messaging/events"
	"bitbucket.org/ifs-pd/nga-common/validation"
	"bitbucket.org/ifs-pd/nga-common/validation/check"
	"bitbucket.org/ifs-pd/nga-common/validation/runner"
)

var _ messaging.Event = (*messagingEvents.EventMessage[*CountryCreatedEventV1])(nil)
var _ messaging.MessagePayload = &CountryCreatedEventV1{}

type CountryCreatedEventV1 struct {
	Id        string    `json:"id"`
	CountryId string    `json:"countryId"`
	Name      string    `json:"name"`
	CreatedAt time.Time `json:"createdAt"`
	UpdatedAt time.Time `json:"updatedAt"`
}

var countryCreatedValidator = validation.New(func(e *CountryCreatedEventV1, r *runner.Runner[*CountryCreatedEventV1]) {

	check.StringField(r, "Id", e.Id).
		NotEmpty("id cannot be empty")

	check.StringField(r, "CountryId", e.CountryId).
		NotEmpty("countryId cannot be empty")

	check.StringField(r, "Name", e.Name).
		NotEmpty("name cannot be empty")
})

func (e *CountryCreatedEventV1) Validate(ctx context.Context) error {
	return messaging.Validate(ctx, countryCreatedValidator, e)
}

func (e *CountryCreatedEventV1) ComponentName() string {
	return schema.ComponentName
}

func NewCountryCreatedEventV1(
	id string,
	countryId string,
	name string,
	createdAt time.Time,
	updatedAt time.Time,
) *CountryCreatedEventV1 {

	return &CountryCreatedEventV1{
		Id:        id,
		CountryId: countryId,
		Name:      name,
		CreatedAt: createdAt,
		UpdatedAt: updatedAt,
	}
}
