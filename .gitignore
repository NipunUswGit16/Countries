# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Generated PDF docs build directory
.pdfbuild/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

.trivycache
opengrep-results.json
govet-report.out
test-reports/**
test-reports
report.json
report-unit.json
report-functional.json
cover.out
coverage.out
coverage-unit.out
coverage-functional.out
.test_failed
golangci-lint-report.xml
bin/
vendor/
tmp/
build-errors.log
gosec-report.sonar.json

# Functional test env (local overrides)
test/functional/.env

# Go debug artifacts
cmd/client-api/client-api
cmd/event-handler/event-handler
# Locally built web entrypoint binary (`cd web/entrypoint && go build` names it
# after that module — `web-entrypoint`). It lives beside its Go sources, not the
# Docker build output, so `git add -A` during a migration would otherwise commit
# it. Ignored here (a Go artifact) rather than in the React web/.gitignore.
web/entrypoint/web-entrypoint
# Stray gen-masterdata binary if produced by `go build ./cmd/gen-masterdata`.
# Anchored with a leading `/` (and the cmd/-relative path) so the pattern
# never matches the cmd/gen-masterdata/ source directory itself.
/gen-masterdata
cmd/gen-masterdata/gen-masterdata

# Helm chart dependencies
chart/charts/*.tgz
chart/Chart.lock

# Local dependency overrides
local-deps/

# Generated architecture diagrams (local/session artifacts)
docs/diagrams/

# Legacy charts/ path (main uses chart/); ignore so pre-push hooks detect chart/ correctly
charts/

# Agent / IDE local credentials — never commit
.claude/settings.json
.claude/settings.local.json
.kairos/migration/state/
Dockerfile.local
