# .init.mk - Kairos build toolkit initialization
#
# DO NOT EDIT THIS FILE. 
# 
# Use the ./Makefile to introduce any changes to the build targets.

# Minimum Go version required
MIN_GO_VERSION ?= 1.27.3

# Ensure Go tools are in PATH
override PATH := $(shell echo $$PATH):$(HOME)/go/bin

# Resolve environment
GO_BIN     := $(shell command -v go 2> /dev/null)
INFRA_DIR  := $(shell go list -f '{{.Dir}}' bitbucket.org/ifs-pd/kairos-component-common/toolkit 2>/dev/null)

# Extract Go version (removes the 'go' prefix, e.g., 'go1.21.5' -> '1.21.5')
CUR_GO_VER := $(shell go env GOVERSION | sed 's/^go//')

ifeq ($(INFRA_DIR),)
  ifeq ($(BOOTSTRAPPED),)
    # Catch-all target to ensure the build toolkit is downloaded
    %:
	@# --- Pre-flight: Check Go Binary ---
	@if [ -z "$(GO_BIN)" ]; then \
		echo "Error: 'go' not found. Please install Go $(MIN_GO_VERSION)+"; exit 1; \
	fi
	
	@# --- Pre-flight: Check Go Version ---
	@if [ "$$(printf '%s\n%s' "$(MIN_GO_VERSION)" "$(CUR_GO_VER)" | sort -V | head -n1)" != "$(MIN_GO_VERSION)" ]; then \
		echo "Error: Go version $(CUR_GO_VER) is too old. Minimum required is $(MIN_GO_VERSION)."; exit 1; \
	fi

	@echo "Build toolkit not found. Downloading..."
	@go mod tidy || (echo "Error: go mod tidy failed."; exit 1)
	@go mod download || (echo "Error: Download failed."; exit 1)
	@$(MAKE) $@ BOOTSTRAPPED=1
  else
    $(error Failed to download Build Toolkit. Check go.mod entries.)
  endif
else
  # Build toolkit available in $(MK)
  MK := $(INFRA_DIR)/mk

  GENERATE_MODULES := masterdata json

  # Include core functionality.
  include $(MK)/go.mk

  # Include chart packaging functionality
  include $(MK)/charts-package.mk

  # Include kafka utilities
  include $(MK)/kafka.mk

  # Include SQL migration utilities
  include $(MK)/sql.mk
endif

.PHONY: deploy
deploy: ## [deploy] Deploy the component to local cluster
	@echo "Deploying $(COMPONENT_NAME)..."
	@$(MAKE) -f $(MK)/deploy-local-cluster.mk _deploy COMPONENT_NAME="$(COMPONENT_NAME)"

.PHONY: deploy-delete
deploy-delete: ## [deploy] Delete the component from local cluster
	@echo "Deleting $(COMPONENT_NAME)..."
	@$(MAKE) -f $(MK)/deploy-local-cluster.mk _cleanup COMPONENT_NAME="$(COMPONENT_NAME)"
