# Dev-only: substituted into /env.js when running `pnpm vite dev`.
# Same variable names as public/env.js (Helm substitutes these in deployment).
# `API_BASE_PATH` and `AUTH_BASE_PATH` are path prefixes (defaults `api/v1` and
# `auth/v1`), not localhost URLs.

API_BASE_PATH=api/v1
AUTH_BASE_PATH=auth/v1
FULLSTORY_ORG_ID=xyz
FULLSTORY_DEV_MODE=false
